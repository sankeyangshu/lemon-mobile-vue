{
  "name": "lemon-template-vue",
  "version": "1.1.1",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "description": "An mobile web apps template based on the Vue 3 ecosystem",
  "author": {
    "name": "sankeyangshu",
    "email": "sankeyangshu@gmail.com",
    "url": "https://github.com/sankeyangshu"
  },
  "license": "MIT",
  "homepage": "https://github.com/sankeyangshu/lemon-template-vue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sankeyangshu/lemon-template-vue.git"
  },
  "bugs": {
    "url": "https://github.com/sankeyangshu/lemon-template-vue/issues"
  },
  "keywords": [
    "vue",
    "vite",
    "templates",
    "echarts",
    "typescript",
    "vant",
    "vueuse",
    "pinia",
    "i18n",
    "tailwindcss"
  ],
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=8.15.4"
  },
  "scripts": {
    "dev": "vite",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "build:test": "vite build --mode test",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "clean:cache": "rimraf node_modules/.cache/ && rimraf node_modules/.vite",
    "clean:lib": "rimraf node_modules",
    "release": "bumpp",
    "preinstall": "npx only-allow pnpm",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@vueuse/core": "^13.6.0",
    "axios": "^1.11.0",
    "dayjs": "^1.11.13",
    "echarts": "^6.0.0",
    "es-toolkit": "^1.39.9",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.3",
    "vant": "^4.9.21",
    "vue": "^3.5.18",
    "vue-i18n": "^11.1.11",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@iconify/vue": "^5.0.0",
    "@sankeyangshu/eslint-config": "^2.2.0",
    "@types/node": "^22.17.1",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "ansis": "^4.1.0",
    "autoprefixer": "^10.4.21",
    "boxen": "^8.0.1",
    "bumpp": "^10.2.2",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "^10.4.0",
    "gradient-string": "^3.0.0",
    "lint-staged": "^16.1.5",
    "postcss": "^8.5.6",
    "postcss-mobile-forever": "^5.0.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "sass": "^1.90.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~5.9.2",
    "unplugin-vue-components": "^29.0.0",
    "vite": "^7.1.1",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-restart": "^1.0.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "npx --no-install commitlint --edit $1"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
